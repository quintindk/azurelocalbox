{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "localCredential": {
      "type": "securestring"
    },
    "domainCredential": {
      "type": "securestring"
    }
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "kv-lbox-weu-4766ea/smal-localbox-01-LocalAdminCredential",
      "properties": {
        "contentType": "Secret",
        "value": "[parameters('localCredential')]",
        "attributes": {
          "enabled": true
        }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "kv-lbox-weu-4766ea/smal-localbox-01-AzureStackLCMUserCredential",
      "properties": {
        "contentType": "Secret",
        "value": "[parameters('domainCredential')]",
        "attributes": {
          "enabled": true
        }
      }
    }
  ]
}
